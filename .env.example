# ============================================================================
# Google Cloud & Gemini Enterprise Agent Platform Configuration
# ============================================================================
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="us-central1"
GOOGLE_GENAI_USE_VERTEXAI="TRUE"

# Set DATA_BACKEND="mock" for zero-config instant local execution & workshops,
# or DATA_BACKEND="gcp" to connect to live Cloud Firestore, BigQuery, & RAG Engine.
DATA_BACKEND="mock"

# ============================================================================
# Google Models Lineup (docs.cloud.google.com/gemini-enterprise-agent-platform/models/google-models)
# ============================================================================
# High-capability reasoning model for multi-step planning, marketing strategy, & churn root-cause
GEMINI_PRO_MODEL="gemini-3.1-pro-preview"

# Fast, balanced model for low-latency customer triage, tool loops, & extraction
GEMINI_FLASH_MODEL="gemini-3-flash-preview"

# Ultra-low latency / cost-efficient model for high-volume classification
GEMINI_FLASH_LITE_MODEL="gemini-3.1-flash-lite"

# High-fidelity visual & promotional asset generation (Nano Banana 2.1 / Gemini 3.1 Flash Image)
GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"

# ============================================================================
# Data Layer & Gemini Enterprise Resource Identifiers (Used when DATA_BACKEND="gcp")
# ============================================================================
VERTEX_SEARCH_DATA_STORE_ID="aura-brand-and-catalog-store"
FIRESTORE_DATABASE="(default)"
BIGQUERY_DATASET="smb_customer_analytics"
GEMINI_ENTERPRISE_APP_ID="your-gemini-enterprise-app-id"
REASONING_ENGINE_ID="projects/your-gcp-project-id/locations/us-central1/reasoningEngines/1234567890"

# ============================================================================
# Governance, Security & Guardrails (Agent Identity, Agent Gateway, HITL)
# ============================================================================
MAX_AUTONOMOUS_DISCOUNT_PCT="20"
MODEL_ARMOR_TEMPLATE_ID="projects/your-gcp-project-id/locations/us-central1/templates/smb-default-armor"
ENABLE_CLOUD_TRACE="FALSE"
